<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.jenkins-ci.plugins</groupId>
    <artifactId>plugin</artifactId>
    <version>6.2236.v12dd4c483242</version>
    <relativePath />
  </parent>

  <groupId>io.jenkins.plugins</groupId>
  <artifactId>artifacts-tab</artifactId>
  <version>0.1.0</version>
  <packaging>hpi</packaging>
  <name>Artifacts Tab</name>

  <properties>
    <!-- jenkins.model.Tab exists since 2.532 -->
    <jenkins.version>2.583</jenkins.version>
    <!-- core 2.583 is built for Java 21; parent default is 17 -->
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <build>
    <finalName>${project.artifactId}-${project.version}</finalName>
  </build>

  <repositories>
    <repository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </repository>
  </repositories>
  <pluginRepositories>
    <pluginRepository>
      <id>repo.jenkins-ci.org</id>
      <url>https://repo.jenkins-ci.org/public/</url>
    </pluginRepository>
  </pluginRepositories>
</project>
